#!/bin/sh
# Runs before every push. The whole gate, the same command CI runs: fmt, clippy with
# -D warnings, the test suite, layers, assets, docs, text and the Welcome notebook check.
# Two to four minutes warm, once per push rather than once per commit.
#
# This is the one that matters. CI only ever sees pushes, so this is the last place a red
# tree can be caught before it is public.
#
# Skip once:        git push --no-verify
# Turn off for good: git config --unset core.hooksPath
set -e

# Quality level L2. Rebased on the newest origin/main, with no merge commits, so the branch
# lands as a fast-forward. Coverage is not run here: it rebuilds everything, so it runs on
# demand and in CI on the pull request.
echo "pre-push (quality level L2): branch, pii, cargo xtask ci"
if ! cargo xtask check-branch --push; then
    echo
    echo "pre-push: rebase on origin/main first. See SKILLS/nc-devx/SKILL.md, quality levels."
    exit 1
fi

# PII check first (fail fast)
echo "pre-push: checking for PII..."
if ! bash SKILLS/nc-devx/scripts/check-pii.sh origin/main; then
    echo
    echo "pre-push: PII check failed. Remove sensitive data before pushing."
    exit 1
fi

echo "pre-push: cargo xtask ci (this takes a few minutes)"
if ! cargo xtask ci; then
    echo
    echo "pre-push: the gate failed. This is what CI would have told you, only sooner."
    echo "          Push anyway with --no-verify if you mean to."
    exit 1
fi

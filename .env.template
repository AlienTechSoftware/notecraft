# Local development settings for NoteCraft.
# Copy this file to .env and replace only the values you need.
# Keep .env private. Do not put credentials, private hostnames, or personal paths here.

# Scratch output used by local proofs of concept and temporary manifests.
TEMP=D:\temp\notecraft

# Local clone of the Fluent UI System Icons source used when selecting icons.
NOTECRAFT_ICON_SOURCE=C:\path\to\fluentui-system-icons

# Optional local notebook and settings overrides.
NOTECRAFT_NOTEBOOKS=
NOTECRAFT_SETTINGS=
NOTECRAFT_DATA_DIR=

# Optional UI test and control-channel settings.
NOTECRAFT_UI_VISUAL_DIR=
NOTECRAFT_CONTROL_PORT=
NOTECRAFT_CONTROL_KEY=

# Optional OfficeIMO bridge executable used by import development.
NOTECRAFT_OFFICEIMO_BRIDGE=

# Documentation and build output controls.
UPDATE_DOCS=
DIST=
CARGO_TARGET_DIR=
NOTECRAFT_VERSION=

# Optional Windows signing settings. Leave empty for local unsigned builds.
SIGNTOOL=
WINDOWS_CERTIFICATE=
WINDOWS_CERTIFICATE_PASSWORD=
WINDOWS_TIMESTAMP_URL=
AZURE_SIGNING_ENDPOINT=
AZURE_SIGNING_ACCOUNT=
AZURE_CERT_PROFILE=

+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
+  <title>NoteCraft</title>
+  <link data-trunk rel="icon" href="../../assets/brand/notecraft-64.png" />
+  <link data-trunk rel="rust" data-bin="notecraft-web" data-wasm-opt="0" data-cargo-profile="playground-web" />
+  <!-- The CJK face, loaded when a page needs it (src/main.rs), with its licence -->
+  <link data-trunk rel="copy-file" href="../../assets/fonts/NotoSansCJKsc-Regular.otf" />
+  <link data-trunk rel="copy-file" href="../../assets/fonts/OFL-NotoSansCJKsc.txt" />
+  <style>
+    html, body { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: #f3f1f8; }
+    #notecraft_canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
+    #notecraft_loading { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
+      color: #555; font: 14px system-ui, sans-serif; pointer-events: none; }
+    @media (prefers-color-scheme: dark) { html, body { background: #1d1b22; } #notecraft_loading { color: #bbb; } }
+  </style>
+</head>
+<body>
+  <canvas id="notecraft_canvas"></canvas>
+  <div id="notecraft_loading">Loading NoteCraft&hellip;</div>
+</body>
+</html>

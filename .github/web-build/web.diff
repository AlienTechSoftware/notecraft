+# NoteCraft in the browser, for Playground (patches/onenote.yaml in github.com/daijro/openplayground).
+# The window is crates/ui-egui; crates/model/src/playground.rs gives the library its files and clock on wasm.
+# Build with: trunk build --release   (from apps/notecraft-web)
+[package]
+name = "notecraft-web"
+version.workspace = true
+edition.workspace = true
+rust-version.workspace = true
+license.workspace = true
+publish.workspace = true
+description = "NoteCraft in the browser"
+
+[[bin]]
+name = "notecraft-web"
+path = "src/main.rs"
+
+[target.'cfg(target_arch = "wasm32")'.dependencies]
+notecraft-engine = { workspace = true }
+notecraft-formats = { workspace = true }
+notecraft-model = { workspace = true }
+notecraft-store = { workspace = true }
+notecraft-ui-egui = { workspace = true }
+eframe = { workspace = true }
+egui = { workspace = true }
+wasm-bindgen = "0.2"
+wasm-bindgen-futures = "0.4"
+js-sys = "0.3"
+web-sys = { version = "0.3", features = ["Window", "Document", "Element", "HtmlCanvasElement", "Location", "console"] }

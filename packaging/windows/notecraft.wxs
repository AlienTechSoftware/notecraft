<?xml version="1.0" encoding="utf-8"?>
<!--
  NoteCraft MSI (WiX Toolset v5: `dotnet tool install -g wix` at version 5.0.2, plus its UI and Util
  extensions: `wix extension add -g WixToolset.UI.wixext/5.0.2` and the same for
  WixToolset.Util.wixext/5.0.2). Built by package.ps1:

    wix build notecraft.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -d Version=1.2.3 -d BinDir=... -d IconPath=... -d LicenseRtf=... -o out.msi

  Per-machine install into Program Files with a Start Menu shortcut. The installer shows the
  standard WiX dialogs: welcome and licence, progress, and a finish page.

  The installer never touches the user's notebooks. They are plain folders under Documents, and
  uninstalling removes only the program files.

  UpgradeCode and the component GUIDs below belong to NoteCraft alone. Never change the
  UpgradeCode after the first public release: Windows Installer would stop treating a new
  version as an upgrade of the old one, and both would sit side by side.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="NoteCraft"
      Manufacturer="AlienTech Software"
      Version="$(var.Version)"
      UpgradeCode="C2662B42-6578-43FF-821B-818575EF96BD"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="NoteCraft note taking" Manufacturer="AlienTech Software" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of NoteCraft is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="NotecraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="NotecraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/AlienTechSoftware/notecraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/AlienTechSoftware/notecraft/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/AlienTechSoftware/notecraft/issues" />

    <!-- WixUI_Minimal: welcome and licence, progress, then a finish page. The finish page offers
         to launch NoteCraft (ticked by default); silent installs (/qn) never show it. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch NoteCraft" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#NotecraftExe]" />
    <CustomAction Id="LaunchNotecraft" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec"
        Impersonate="yes" Return="ignore" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchNotecraft"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="NoteCraft" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="NoteCraft" Level="1">
      <ComponentGroupRef Id="NotecraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="NotecraftFiles" Directory="INSTALLFOLDER">
      <Component Id="NotecraftApp" Guid="154A19E7-AB76-4B48-994F-8DE5BAE61F47">
        <File Id="NotecraftExe" Source="$(var.BinDir)\notecraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="NoteCraft"
              Description="NoteCraft note taking" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="NotecraftIcon.ico" IconIndex="0" />
        </File>
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\notecraft.exe" Value="[#NotecraftExe]" Type="string" />
      </Component>

      <Component Id="NotecraftCli" Guid="E3061CAE-99C3-48E0-8250-8C192AABBFFA">
        <File Id="NotecraftCliExe" Source="$(var.BinDir)\notecraft-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
